ELASTICSEARCH_URL=https://your-project.es.us-east-1.aws.elastic.cloud
ELASTICSEARCH_API_KEY=your-api-key
OPENROUTER_API_KEY=your-openrouter-key

# Index your data lands in (created automatically by the ingest script):
KNOWLEDGE_INDEX=knowledge-base
# Self-managed Elasticsearch only - omit on Serverless (Jina v5 is automatic):
# INFERENCE_ID=jina-v5-embeddings
# Inference endpoint the memory-agent uses to embed conversation messages.
# Omit on Serverless (defaults to the preconfigured Jina v5 endpoint):
# MEMORY_INFERENCE_ID=.jina-embeddings-v5-text-small
